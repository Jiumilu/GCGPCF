{
  "contract_id": "globalcloud.kds.canonical-read",
  "contract_revision": "release0.v1-candidate",
  "status": "candidate_not_frozen_not_implemented",
  "canonical_dependency": {
    "contract_id": "globalcloud.knowledge_asset",
